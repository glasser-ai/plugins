      "type": "streamable-http",
      "url": "https://api.glasser.ai/mcp?toolset=prospect&utm_source=glasser-prospect-lists&utm_medium=plugin",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp"
            ],
            "defaultScopes": [
              "mcp"
            ]
          }
        }
      }
    }
  }
